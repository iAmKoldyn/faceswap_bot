<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FaceFusion Mobile MVP"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHealth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Health: unknown"
                android:textSize="12sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/editBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:inputType="textUri"
            android:hint="Base URL" />

        <TextView
            android:id="@+id/txtHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tip: Android Emulator uses http://10.0.2.2:8000"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/authLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Authorization" />

        <EditText
            android:id="@+id/editAccessToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Access token (paste here, no Bearer)"
            android:inputType="textVisiblePassword|textNoSuggestions" />

        <TextView
            android:id="@+id/txtAuthStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Auth: not set" />

        <EditText
            android:id="@+id/editJobId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Job ID (optional)"
            android:inputType="textNoSuggestions" />

        <Button
            android:id="@+id/btnCheckJob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Check job status" />

        <TextView
            android:id="@+id/txtJobStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Job: n/a" />

        <TextView
            android:id="@+id/modeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Mode" />

        <RadioGroup
            android:id="@+id/radioMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/modePhotoVideoFast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Photo -> Video (fast)" />

            <RadioButton
                android:id="@+id/modePhotoVideoQuality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Photo -> Video (quality)" />

            <RadioButton
                android:id="@+id/modePhotoPhotoGpen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Photo -> Photo (gpen)" />

            <RadioButton
                android:id="@+id/modePhotoPhotoCodeformer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Photo -> Photo (codeformer)" />
        </RadioGroup>

        <Button
            android:id="@+id/btnTakeSelfie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Source actions" />

        <TextView
            android:id="@+id/txtSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Source: not selected" />

        <ImageView
            android:id="@+id/imgSourcePreview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="6dp"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPickTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Pick target" />

        <TextView
            android:id="@+id/txtTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Target: not selected" />

        <ImageView
            android:id="@+id/imgTargetPreview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="6dp"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Start job" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Status: idle" />

        <FrameLayout
            android:id="@+id/resultImageContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true" />

            <ImageButton
                android:id="@+id/btnSaveResult"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@android:color/transparent"
                android:contentDescription="Save image"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_save" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/resultVideoContainer"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <VideoView
                android:id="@+id/videoResult"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageButton
                android:id="@+id/btnSaveVideoResult"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@android:color/transparent"
                android:contentDescription="Save video"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_save" />
        </FrameLayout>

    </LinearLayout>
</ScrollView>
